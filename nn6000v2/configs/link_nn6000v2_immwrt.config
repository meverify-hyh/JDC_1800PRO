# ============================================
# Target: JDCloud RE-SS-01 (AX1800 Pro)
# Role:   Pure Access Point (AP)
# Features: WiFi AP + Debug Tools + Web Terminal
# ============================================

CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01="jdcloud_re-ss-01"
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# TARGET config
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# NSS Firmware Configuration
CONFIG_FEED_nss_packages=n
CONFIG_FEED_sqm_scripts_nss=n
CONFIG_NSS_FIRMWARE_VERSION_12_5=y

# ============================================
# WiFi Drivers (CORE - MUST KEEP)
# ============================================
CONFIG_PACKAGE_kmod-ath=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=y
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=y

# WiFi Utilities
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_hostapd-common=y

# ============================================
# Compile Settings
# ============================================
CONFIG_USE_APK=n
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# BUSYBOX
CONFIG_BUSYBOX_CUSTOM=y

# ============================================
# Core Network (MUST KEEP)
# ============================================
CONFIG_PACKAGE_luci-proto-relay=y

# Libraries
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-conf=y

# Disable
CONFIG_PACKAGE_automount=n

# DNS (keep dnsmasq, DHCP will be disabled later via config)
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y

# DEFAULT SET
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# ============================================
# NETWORK MODULES (keep basic)
# ============================================
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-dsa=y
CONFIG_PACKAGE_kmod-tls=y

# Filesystems (AP only needs basic filesystem support)
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-squashfs=y
CONFIG_PACKAGE_kmod-fs-overlay=y

# USB Support (minimal, keep for basic USB detection)
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y

# USB Ethernet adapters (optional, keep for flexibility)
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# ============================================
# DEBUG TOOLS (保留)
# ============================================
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_socat=y

# ============================================
# FILE TOOLS (保留)
# ============================================
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_e2fsprogs=y

# ============================================
# WEB TERMINAL (保留)
# ============================================
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

# ============================================
# Essential Tools (minimal)
# ============================================
CONFIG_PACKAGE_rng-tools=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_ipset=y

# ============================================
# LuCI Web Interface (keep basic)
# ============================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-autoreboot=y

# ============================================
# REMOVED: Firewall (完全移除)
# ============================================
CONFIG_PACKAGE_firewall=n
CONFIG_PACKAGE_firewall4=n
CONFIG_PACKAGE_luci-app-firewall=n

# REMOVED: nftables (防火墙依赖)
CONFIG_PACKAGE_kmod-nft-core=n
CONFIG_PACKAGE_kmod-nft-fib=n
CONFIG_PACKAGE_kmod-nft-offload=n
CONFIG_PACKAGE_kmod-nft-nat=n
CONFIG_PACKAGE_kmod-nft-nat6=n
CONFIG_PACKAGE_kmod-nft-fullcone=n
CONFIG_PACKAGE_kmod-nft-bridge=n
CONFIG_PACKAGE_kmod-nft-queue=n
CONFIG_PACKAGE_kmod-nft-netdev=n

# REMOVED: iptables (兼容层)
CONFIG_PACKAGE_iptables=n
CONFIG_PACKAGE_ip6tables=n
CONFIG_PACKAGE_kmod-ipt-core=n
CONFIG_PACKAGE_kmod-ipt-nat=n
CONFIG_PACKAGE_kmod-ipt-conntrack=n
CONFIG_PACKAGE_kmod-ipt-offload=n

# ============================================
# REMOVED: USB Cellular / Modem
# ============================================
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=n
CONFIG_PACKAGE_kmod-usb-serial-option=n
CONFIG_PACKAGE_kmod-usb-serial-wwan=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-printer=n
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=n
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=n
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=n
CONFIG_PACKAGE_uqmi=n
CONFIG_PACKAGE_libqmi=n
CONFIG_PACKAGE_luci-proto-qmi=n
CONFIG_PACKAGE_umbim=n
CONFIG_PACKAGE_libmbim=n
CONFIG_PACKAGE_luci-proto-mbim=n
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=n
CONFIG_PACKAGE_kmod-usb-net-rtl8150=n
CONFIG_PACKAGE_kmod-usb-net-rtl8152=n
CONFIG_PACKAGE_kmod-usb-net-asix=n
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=n
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=n
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=n
CONFIG_PACKAGE_kmod-usb-net-ipheth=n
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=n
CONFIG_PACKAGE_usb-modeswitch=n

# ============================================
# REMOVED: VPN
# ============================================
CONFIG_PACKAGE_kmod-wireguard=n
CONFIG_PACKAGE_wireguard-tools=n
CONFIG_PACKAGE_luci-proto-wireguard=n

# ============================================
# REMOVED: File Sharing
# ============================================
CONFIG_PACKAGE_kmod-fs-exfat=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ntfs3=n
CONFIG_PACKAGE_kmod-fs-cifs=n
CONFIG_PACKAGE_kmod-fs-nfs=n
CONFIG_PACKAGE_ntfs3-mount=n
CONFIG_PACKAGE_luci-app-samba4=n

# ============================================
# REMOVED: Virtualization
# ============================================
CONFIG_PACKAGE_kmod-veth=n
CONFIG_PACKAGE_kmod-tun=n

# ============================================
# REMOVED: Unnecessary Tools (减少体积)
# ============================================
CONFIG_PACKAGE_wget=n
CONFIG_PACKAGE_iperf3=n
CONFIG_PACKAGE_openssl-util=n
CONFIG_PACKAGE_qrencode=n
CONFIG_PACKAGE_smartmontools-drivedb=n
CONFIG_PACKAGE_xz-utils=n
CONFIG_PACKAGE_bash=n
CONFIG_PACKAGE_openssh-sftp-server=n
CONFIG_PACKAGE_fuse-utils=n
CONFIG_PACKAGE_sgdisk=n

# lldpd
CONFIG_PACKAGE_lldpd=y
CONFIG_PACKAGE_luci-app-lldpd=y

# lldpd 额外功能（根据需求可选）
 CONFIG_PACKAGE_lldpd-utils=y          # lldp 实用工具
 CONFIG_PACKAGE_lldpd-client=y         # lldp 客户端
 CONFIG_PACKAGE_lldpd-server=y         # lldp 服务端（默认已包含）





# ============================================
# REMOVED: LuCI Apps (AP 不需要)
# ============================================
CONFIG_PACKAGE_luci-app-quickfile=n
CONFIG_PACKAGE_luci-app-istore=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-pbr=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-p910nd=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-tailscale-community=n
CONFIG_PACKAGE_luci-app-easytier=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-argon-config=n
