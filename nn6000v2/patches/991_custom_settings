config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '0004cf96e4c675b554c6af26748beb87b8cb'
	option packet_steering '0'

#===============================================================================
# 802.1Q 子接口（VLAN 233 / 100 / 200）
#===============================================================================

# ---------- lan1 ----------
config device 'lan1_vlan233'
	option name 'lan1.233'
	option type '8021q'
	option ifname 'lan1'
	option vid '233'

config device 'lan1_vlan100'
	option name 'lan1.100'
	option type '8021q'
	option ifname 'lan1'
	option vid '100'

config device 'lan1_vlan200'
	option name 'lan1.200'
	option type '8021q'
	option ifname 'lan1'
	option vid '200'

# ---------- lan2 ----------
config device 'lan2_vlan233'
	option name 'lan2.233'
	option type '8021q'
	option ifname 'lan2'
	option vid '233'

config device 'lan2_vlan100'
	option name 'lan2.100'
	option type '8021q'
	option ifname 'lan2'
	option vid '100'

config device 'lan2_vlan200'
	option name 'lan2.200'
	option type '8021q'
	option ifname 'lan2'
	option vid '200'

# ---------- lan3 ----------
config device 'lan3_vlan233'
	option name 'lan3.233'
	option type '8021q'
	option ifname 'lan3'
	option vid '233'

config device 'lan3_vlan100'
	option name 'lan3.100'
	option type '8021q'
	option ifname 'lan3'
	option vid '100'

config device 'lan3_vlan200'
	option name 'lan3.200'
	option type '8021q'
	option ifname 'lan3'
	option vid '200'

#===============================================================================
# 三个 VLAN 网桥
# 注意：ports 引用的是 UCI device 段名（带下划线），不是 netdev 名
#===============================================================================

# ---------- 管理 VLAN 233 网桥 ----------
config device 'br_vlan233'
	option name 'br-vlan233'
	option type 'bridge'
	list ports 'lan1_vlan233'
	list ports 'lan2_vlan233'
	list ports 'lan3_vlan233'

# ---------- 业务 VLAN 100 网桥 ----------
config device 'br_vlan100'
	option name 'br-vlan100'
	option type 'bridge'
	list ports 'lan1_vlan100'
	list ports 'lan2_vlan100'
	list ports 'lan3_vlan100'

# ---------- 访客 VLAN 200 网桥 ----------
config device 'br_vlan200'
	option name 'br-vlan200'
	option type 'bridge'
	list ports 'lan1_vlan200'
	list ports 'lan2_vlan200'
	list ports 'lan3_vlan200'

#===============================================================================
# 接口
#===============================================================================

config interface 'lan'
	option device 'br-vlan233'
	option proto 'static'
	option ipaddr '192.168.2.253'
	option netmask '255.255.255.0'
	option gateway '192.168.2.254'
	option dns '223.5.5.5 119.29.29.29'
	option ip6assign '64'
	option ip6ifaceid 'eui64'
